NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only: Claude API key (https://platform.claude.com) — Biznes reja AI uchun
ANTHROPIC_API_KEY=sk-ant-...

# Aloqa: admin Telegram username (@ belgisisiz). Bo'sh bo'lsa, Telegram havolasi yashiriladi.
NEXT_PUBLIC_ADMIN_TELEGRAM=

# Telegram orqali kirish (ixtiyoriy):
#  1) @BotFather'da bot yarating, /setdomain bilan sayt domenini ulang
#  2) Bot ID — tokenning ":" dan oldingi qismi
NEXT_PUBLIC_TELEGRAM_BOT_ID=
TELEGRAM_BOT_TOKEN=
# Server-only: Supabase service role key (Telegram foydalanuvchilarini yaratish uchun)
SUPABASE_SERVICE_ROLE_KEY=
